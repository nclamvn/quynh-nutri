{
  "name": "quynh-nutri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint && npm run check:typography",
    "check:typography": "node scripts/check-typography.mjs",
    "check": "npm run lint && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:onboarding": "playwright test --config=playwright.onboarding.config.ts",
    "test:security": "playwright test e2e/security-readiness.spec.ts",
    "test:marketing": "playwright test --config=playwright.marketing.config.ts",
    "test:stress": "node scripts/stress-test.mjs",
    "metrics:activation": "tsx scripts/product-funnel.ts",
    "metrics:retention-dry-run": "node scripts/product-event-retention-dry-run.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "test:readiness": "npm run audit:production && npm run build && npm run test:security && npm run test:marketing && npm run test:stress",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate-pantry-lots": "node scripts/migrate-pantry-lots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/nextjs": "^7.6.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "ai": "^7.0.41",
    "leaflet": "^1.9.4",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.17"
    }
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.14",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

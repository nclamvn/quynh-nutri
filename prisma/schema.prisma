// Meal SOT — persistence contract (Blueprint §3).
// Postgres because the domain needs native enums + scalar arrays.
// Runtime dev data lives as typed TS in src/data/seed/*; this schema is the
// contract for when a real Postgres (Supabase/Neon) is wired via the repo layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────
enum ProvenanceLevel {
  P1 // Bảng Thành phần Thực phẩm VN (Viện Dinh dưỡng)
  P2 // Nhu cầu Dinh dưỡng Khuyến nghị 2016
  P3 // HD dinh dưỡng mẹ mang thai & cho con bú 2017
  P4 // FAO/INFOODS ASEAN
  P5 // USDA
  P6 // WHO/FAO
}

enum Confidence {
  corroborated // ≥2 nguồn độc lập khớp
  disputed // nguồn vênh nhau
  honest_null // chưa đủ dữ liệu — không đoán
}

enum ProteinType {
  bo
  ga
  ca
  tom
  heo
  cua
  trung
  dau
  rau
}

enum CookMethod {
  kho
  xao
  luoc
  hap
  nuong
  ran
  song
}

enum Slot {
  COM
  MAN
  RAU
  CANH
  TRANGMIENG
}

enum MealOccasion {
  breakfast
  lunch
  dinner
  snack
}

enum MemberRole {
  adult
  child
}

enum Activity {
  light
  moderate
  heavy
}

enum StorageLocation {
  pantry
  fridge
  freezer
}

enum InventoryMovementKind {
  consumed
  discarded
}

enum LeftoverStorageLocation {
  fridge
  freezer
}

enum LeftoverMovementKind {
  consumed
  discarded
  corrected
}

// ─── A: Commodity (macro/100g, provenance) ───────────────────────────────
model CommodityIngredient {
  id              String          @id
  canonicalVn     String // khóa ngữ nghĩa (canonical)
  labelEn         String? // chỉ hiển thị; thiếu → fallback VN
  group           String // 14 nhóm theo Bảng 2016
  kcal            Float
  proteinG        Float
  carbG           Float
  fatG            Float
  fiberG          Float
  provenanceLevel ProvenanceLevel
  confidence      Confidence
  sourceRefs      Json // [{ source, value }]
  seasonMonths    Int[]
  storageNote     String?
  substitutes     String[] // commodity ids cùng slot/vai trò

  repertoireLines RepertoireLine[]
  householdLines  HouseholdLine[]
  shoppingItems   ShoppingItem[]
}

// ─── B0: Repertoire phổ dụng (system-owned seed) ─────────────────────────
model RepertoireDish {
  id           String           @id
  vnName       String
  enLabel      String?
  proteinType  ProteinType
  method       CookMethod
  slot         Slot
  quick        Boolean          @default(false)
  baseServings Int              @default(4)
  prepAhead    String[]
  cookTimeMin  Int?
  tags         String[]
  lines        RepertoireLine[]
  forks        HouseholdDish[]
}

model RepertoireLine {
  id          String              @id @default(cuid())
  dishId      String
  dish        RepertoireDish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  commodityId String
  commodity   CommodityIngredient @relation(fields: [commodityId], references: [id])
  qtyBase     Float // cho baseServings
  unit        String
}

// ─── B1: Household dish (override B0) ─────────────────────────────────────
model HouseholdDish {
  id                 String          @id @default(cuid())
  householdId        String
  household          Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sourceRepertoireId String? // null = món tự tạo
  source             RepertoireDish? @relation(fields: [sourceRepertoireId], references: [id])
  vnName             String
  enLabel            String?
  proteinType        ProteinType
  method             CookMethod
  slot               Slot
  quick              Boolean         @default(false)
  baseServings       Int             @default(4)
  vendor             String? // hàng ngoài chợ
  isFavorite         Boolean         @default(false)
  cookTimeMin        Int?
  tags               String[]
  lines              HouseholdLine[]
  daySlots           DaySlot[]
}

model HouseholdLine {
  id          String              @id @default(cuid())
  dishId      String
  dish        HouseholdDish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  commodityId String
  commodity   CommodityIngredient @relation(fields: [commodityId], references: [id])
  qtyBase     Float
  unit        String
}

// ─── Household ───────────────────────────────────────────────────────────
model Household {
  id                      String                   @id @default(cuid())
  userId                  String?                  @unique // Clerk user → their household (multi-tenant)
  name                    String
  size                    Int
  marketMode              String                   @default("mixed")
  cookTimeCapMin          Int                      @default(45)
  busyDays                String[] // ["Mon","Wed"]
  lactatingMember         Boolean                  @default(false)
  restrictions            String[] // diet: vegetarian, no_pork, …
  reminderEnabled         Boolean                  @default(false)
  reminderTimeZone        String                   @default("Asia/Ho_Chi_Minh")
  reminderHour            Int                      @default(7)
  // Mutable per-household user state (Phase A persistence). Collections kept on
  // the household row to avoid many tiny tables; promote to relations if needed.
  favorites               String[] // dish ids
  notes                   Json                     @default("[]") // [{id, text}]
  pantry                  Json                     @default("[]") // [{commodityId, qty, unit, expiry?}]
  members                 Member[]
  dishes                  HouseholdDish[]
  weekPlans               WeekPlan[]
  suppliers               Supplier[]
  orders                  Order[]
  purchases               PurchaseRecord[]
  inventoryLots           InventoryLot[]
  inventoryMovements      InventoryMovement[]
  leftoverLots            LeftoverLot[]
  leftoverMovements       LeftoverMovement[]
  shoppingFulfillments    ShoppingFulfillment[]
  shoppingReceiveRequests ShoppingReceiveRequest[]
  pushSubscriptions       PushSubscription[]
  kitchenSessions         KitchenSession[]
  mealCompletions         MealCompletion[]
  mealFeedbacks           MealFeedback[]
  productEvents           ProductEvent[]
}

// Privacy-minimal product measurement. Events explain adoption of the canonical
// household loop but never become task state or a second source of truth.
model ProductEvent {
  id            String    @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name          String
  schemaVersion Int       @default(1)
  dedupeKey     String
  properties    Json      @default("{}")
  occurredAt    DateTime  @default(now())

  @@unique([householdId, dedupeKey])
  @@index([name, occurredAt])
  @@index([householdId, occurredAt])
}

// Active, manually-driven kitchen execution only. Completion deletes the row;
// this is not a generated task ledger or a historical "done" record.
model KitchenSession {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  kind        String
  scopeKey    String
  payload     Json
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([householdId, kind, scopeKey])
  @@index([householdId, updatedAt])
}

// Immutable household confirmation that a reviewed kitchen session was
// actually completed. This is execution evidence, never a generated task or a
// generic mutable "done" ledger.
model MealCompletion {
  id                     String              @id @default(cuid())
  householdId            String
  household              Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  idempotencyKey         String
  weekRef                String
  day                    Int
  occasion               MealOccasion        @default(dinner)
  dishRefs               String[]
  sourceSessionCreatedAt DateTime
  completedAt            DateTime
  createdByUserId        String
  inventoryMovements     InventoryMovement[]
  leftoverLots           LeftoverLot[]
  feedback               MealFeedback[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([householdId, idempotencyKey])
  @@unique([householdId, weekRef, day, occasion, sourceSessionCreatedAt])
  @@index([householdId, weekRef, day, occasion])
  @@index([householdId, completedAt])
}

// Direct household feedback for one dish in one confirmed meal. This is never
// inferred from leftovers, inventory, clicks, favorites or model output.
model MealFeedback {
  id               String         @id @default(cuid())
  householdId      String
  household        Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  mealCompletionId String
  mealCompletion   MealCompletion @relation(fields: [mealCompletionId], references: [id], onDelete: Cascade)
  dishRef          String
  idempotencyKey   String
  repeatIntent     String?
  portionFit       String?
  effortFit        String?
  version          Int            @default(1)
  createdByUserId  String
  updatedByUserId  String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([householdId, idempotencyKey])
  @@unique([mealCompletionId, dishRef])
  @@index([householdId, updatedAt])
  @@index([householdId, dishRef])
}

// Web Push is an explicitly enabled delivery channel around the derived
// kitchen agenda. These rows are device capabilities and delivery receipts,
// never a second task source or completion ledger.
model PushSubscription {
  id          String             @id @default(cuid())
  householdId String
  household   Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  endpoint    String             @unique
  p256dh      String
  auth        String
  userAgent   String?
  deliveries  ReminderDelivery[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([householdId])
}

model ReminderDelivery {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  taskId         String
  calendarDate   String
  status         String           @default("sending") // sending | sent
  attemptedAt    DateTime         @default(now())
  sentAt         DateTime?

  @@unique([subscriptionId, taskId])
  @@index([attemptedAt])
}

// ── Lane 2 — Purchase log (real-price catch-bucket; pricePaid = B1 ground truth) ──
model PurchaseRecord {
  id                  String               @id @default(cuid())
  householdId         String
  household           Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  date                DateTime             @default(now())
  orderRef            String?
  supplierId          String?
  lines               Json                 @default("[]") // [{ commodityId, qty, unit, pricePaid? }]
  onTime              String? // on_time | late | no_show — subjective household observation
  note                String?
  shoppingFulfillment ShoppingFulfillment?
}

// ── Kitchen Execution — bought-line ground truth + individually traceable lots ──
model ShoppingFulfillment {
  id               String                   @id @default(cuid())
  householdId      String
  household        Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  weekRef          String
  commodityId      String
  vendor           String
  plannedQty       Float
  actualQty        Float
  unit             String
  boughtAt         DateTime
  pricePaid        Int?
  purchaseRecordId String                   @unique
  purchaseRecord   PurchaseRecord           @relation(fields: [purchaseRecordId], references: [id], onDelete: Cascade)
  inventoryLot     InventoryLot?
  receiveRequests  ShoppingReceiveRequest[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([householdId, weekRef, commodityId, vendor])
  @@index([householdId, weekRef])
}

model InventoryLot {
  id                String               @id @default(cuid())
  householdId       String
  household         Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  commodityId       String
  qty               Float
  unit              String
  purchasedAt       DateTime
  storageLocation   StorageLocation
  bestBefore        DateTime?
  sourceWeekRef     String?
  sourceShoppingKey String?
  fulfillmentId     String?              @unique
  fulfillment       ShoppingFulfillment? @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)
  movements         InventoryMovement[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([householdId, commodityId])
  @@index([householdId, sourceWeekRef])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  idempotencyKey String                @unique
  householdId    String
  household      Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inventoryLotId String
  inventoryLot   InventoryLot          @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  kind           InventoryMovementKind
  qty            Float
  unit           String
  qtyBefore      Float
  qtyAfter       Float
  occurredAt     DateTime
  note           String?
  sourceMealCompletionId String?
  sourceMealCompletion   MealCompletion?       @relation(fields: [sourceMealCompletionId], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())

  @@index([householdId, occurredAt])
  @@index([inventoryLotId, occurredAt])
  @@index([sourceMealCompletionId])
}

model ShoppingReceiveRequest {
  idempotencyKey String              @id
  householdId    String
  household      Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fulfillmentId  String
  fulfillment    ShoppingFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())

  @@index([householdId, fulfillmentId])
}

// ── Kitchen Execution — cooked-dish leftovers, never ingredient inventory ──
model LeftoverLot {
  id                  String                  @id @default(cuid())
  idempotencyKey      String
  householdId         String
  household           Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  dishRef             String
  dishLabelSnapshot   String
  remainingServings   Float
  preparedAt          DateTime
  chilledAt           DateTime
  storageLocation     LeftoverStorageLocation
  hotWeatherConfirmed Boolean                 @default(false)
  policyVersion       String
  sourceMealRunRef    String?
  mealCompletionId    String?
  mealCompletion      MealCompletion?          @relation(fields: [mealCompletionId], references: [id], onDelete: SetNull)
  note                String?
  createdByUserId     String
  movements           LeftoverMovement[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([householdId, idempotencyKey])
  @@index([householdId, chilledAt])
  @@index([mealCompletionId])
}

model LeftoverMovement {
  id              String               @id @default(cuid())
  idempotencyKey  String
  householdId     String
  household       Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  leftoverLotId   String
  leftoverLot     LeftoverLot          @relation(fields: [leftoverLotId], references: [id], onDelete: Restrict)
  kind            LeftoverMovementKind
  servings        Float
  beforeServings  Float
  afterServings   Float
  occurredAt      DateTime
  note            String?
  createdByUserId String
  createdAt       DateTime             @default(now())

  @@unique([householdId, idempotencyKey])
  @@index([householdId, leftoverLotId, occurredAt])
}

// ── Phase 2 — Supplier & Order (household-owned; chain registry is code-seed) ──
model Supplier {
  id              String    @id @default(cuid())
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name            String
  type            String // cho | sieu_thi | tiem | online
  channels        Json      @default("[]") // [{ kind, value, label }]
  hours           String?
  shipFee         String?
  shipArea        String?
  handles         String[] // commodity ids / groups
  address         String? // household shop; chains span many branches → omit
  lat             Float? // map pin (household shop only; user-set, never invented)
  lng             Float?
  storeLocatorUrl String? // chain branch-finder URL (honest stand-in for one address)
  note            String?
  sources         String[] // provenance for enriched fields
  needsVerify     Boolean   @default(false)
  orders          Order[]
}

model Order {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  weekRef     String
  lines       Json      @default("[]") // [{ commodityId, qtyGross, unit }]
  status      String    @default("draft") // draft | sent | confirmed | delivered
  channelUsed String?
  sentAt      DateTime?
  note        String?
}

model Member {
  id            String        @id @default(cuid())
  householdId   String
  household     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name          String?
  role          MemberRole
  sex           String?
  ageBand       String?
  activity      Activity      @default(moderate)
  // ── BASE layer (static) ──
  allergies     String[] // shellfish, fish, egg, … — HARD-SAFETY tier
  habits        String[] // everyday eating habits
  conditions    String[] // standing conditions — MEDICAL tier (execute-not-prescribe)
  dislikes      String[] // disliked dishes/ingredients — PREFERENCE tier
  healthProfile Json? // { lifeStage, mode } — T1 special diets (wellness only)
  contextProfile Json? // descriptive profile: measurements, routines, food notes
  // ── STATE layer (dynamic, self-expiring) ──
  states        MemberState[]
}

// Dynamic state that overrides the base while in effect, then SELF-EXPIRES via
// validUntil — no transient "hôm nay ốm" ever becomes a permanent label.
model MemberState {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind       String // illness | mood | context
  value      String
  validFrom  DateTime  @default(now())
  validUntil DateTime?
}

// ─── Planning ────────────────────────────────────────────────────────────
model WeekPlan {
  id           String        @id @default(cuid())
  householdId  String
  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  weekStart    DateTime
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  daySlots     DaySlot[]
  shoppingList ShoppingList?

  @@unique([householdId, weekStart])
}

model DaySlot {
  id               String         @id @default(cuid())
  weekPlanId       String
  weekPlan         WeekPlan       @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  day              Int // 0..6
  occasion         MealOccasion    @default(dinner)
  slot             Slot
  repertoireDishId String? // ref B0
  householdDishId  String? // ref B1
  householdDish    HouseholdDish? @relation(fields: [householdDishId], references: [id])
  locked           Boolean        @default(false)

  @@unique([weekPlanId, day, occasion, slot])
}

model ShoppingList {
  id         String         @id @default(cuid())
  weekPlanId String         @unique
  weekPlan   WeekPlan       @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  items      ShoppingItem[]
}

model ShoppingItem {
  id          String              @id @default(cuid())
  listId      String
  list        ShoppingList        @relation(fields: [listId], references: [id], onDelete: Cascade)
  commodityId String
  commodity   CommodityIngredient @relation(fields: [commodityId], references: [id])
  qtyTotal    Float
  unit        String
  vendor      String?
  trip        Int // chuyến đi chợ
  checked     Boolean             @default(false)
}

// ─── Nutrition cache (derived) ───────────────────────────────────────────
model NutritionCache {
  id          String   @id @default(cuid())
  scope       String // dish | day | member
  refId       String
  macros      Json
  coveragePct Float
  displayMode String // number | range
  computedAt  DateTime @default(now())

  @@unique([scope, refId])
}
